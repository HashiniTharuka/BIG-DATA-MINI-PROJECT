# Copy to .env and adjust if needed. docker-compose reads this automatically.

# ---- Simulated clock ----
# 1 simulated "day" = this many real seconds. 300 = 5 minutes.
SIMULATED_DAY_SECONDS=300
# Seconds between vitals readings per patient (real continuous monitoring, not compressed)
VITALS_INTERVAL_SECONDS=3
# Number of simulated ward patients
NUM_PATIENTS=12
# Probability (0-1) that any given reading is an injected abnormal spike
ABNORMAL_SPIKE_PROBABILITY=0.06

# ---- Postgres ----
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VITALS=vitals-stream

# ---- Observability ----
PUSHGATEWAY_URL=http://pushgateway:9091
